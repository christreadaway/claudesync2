# ClaudeSync Dashboard - Environment Configuration
# Copy this to .env and fill in your values

# Required: Password for the web dashboard login
DASHBOARD_PASSWORD=changeme

# Optional: Path to your repos on the host machine (mounted read-only into container)
REPOS_PATH=/home/user

# Optional: Override the Flask secret key (auto-generated if not set)
# SECRET_KEY=

# Set to any value to enable production mode (secure cookies, etc.)
PRODUCTION=1
